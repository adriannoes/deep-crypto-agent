# Crypto Trading - Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Market Configuration
MARKET_TARGET=US
DATA_FETCH_MODE=LOCAL

# Trading Configuration
INITIAL_CAPITAL=1000000.0
COMMISSION_RATE=0.001

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/crypto_trading.log

# API Configuration (Optional - for live trading)
# Get your API keys from your exchange (Binance, Coinbase, etc.)
API_KEY=
API_SECRET=
API_BASE_URL=

# Database Configuration (Optional - for persistent storage)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Docker Database Configuration (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=crypto_trading

# Development Configuration
DEBUG=false
TESTING=false
